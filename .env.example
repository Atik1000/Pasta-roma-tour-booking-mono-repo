# ---------------------------------------------------------------------------
# Pasta Roma Tour — environment template.
# Copy to `.env` at the repo root, and to `.env.local` inside each app if you
# want app-specific overrides. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Shared -----------------------------------------------------------------
NODE_ENV=development

# --- API (apps/api) ---------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
# Browser origins allowed to call the API. SITE_URL and ADMIN_URL are always
# allowed as well, so in most deployments this can stay empty. Outside
# production any loopback or private-network origin is accepted too — 127.0.0.1,
# a drifted port and a phone on the LAN all work without editing this.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used to build links inside emails (password reset, booking lookup)
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Postgres (Phase 4)
DATABASE_URL=postgresql://pasta:pasta@localhost:5432/pasta_roma_tour?schema=public

# Redis — BullMQ queues and rate limiting (Phase 3)
REDIS_URL=redis://localhost:6379

# JWT (Phase 5). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-48-byte-random-string-000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-to-a-different-48-byte-random-string-00
JWT_REFRESH_TTL=30d

# Stripe (Phase 9) — test-mode keys are fine for development
# Stripe. Test-mode keys (sk_test_… / pk_test_…) are enough to exercise the
# whole flow. Without STRIPE_SECRET_KEY the payment endpoints answer 503 and
# everything else still runs.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/v1/payments/webhook`.
STRIPE_WEBHOOK_SECRET=

# Mail (Phase 3)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Pasta Roma Tour <no-reply@pastaromatour.com>"

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Swagger UI at ${API_PREFIX}/docs
SWAGGER_ENABLED=true

# --- Payments ---------------------------------------------------------------
# Which gateway opens NEW online payments: paypal | revolut | stripe.
# Existing payments always stay with the gateway that took them, so switching
# this does not make yesterday's takings unrefundable.
PAYMENT_PROVIDER=paypal

# Revolut Merchant API — https://developer.revolut.com/docs/merchant/merchant-api
# Sandbox: https://sandbox-merchant.revolut.com   Live: https://merchant.revolut.com
REVOLUT_API_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=
REVOLUT_PUBLIC_KEY=
# From the webhook you create for POST {API}/payments/webhook/revolut.
# Comma-separate two values while rotating the secret.
REVOLUT_WEBHOOK_SECRET=

# PayPal — https://developer.paypal.com/docs/api/orders/v2/
# sandbox (api-m.sandbox.paypal.com) | live (api-m.paypal.com). The mode picks
# the API host AND the SDK the browser loads, so the two cannot be set apart.
PAYPAL_MODE=sandbox
# From Developer Dashboard -> Apps & Credentials -> your REST app.
# The client id is handed to the browser; the secret never leaves the API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you create for POST {API}/payments/webhook/paypal.
# Not a signing key — it is what verify-webhook-signature checks against, and
# without it every event is refused. Sandbox and live have separate ids.
PAYPAL_WEBHOOK_ID=

# --- Public site (apps/web) -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Admin panel (apps/admin) ----------------------------------------------
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# How the browser reaches the API — used to build absolute upload URLs
API_PUBLIC_URL=http://localhost:4000
