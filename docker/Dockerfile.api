# syntax=docker/dockerfile:1
#
# NestJS API. Built from the monorepo root:
#   docker build -f docker/Dockerfile.api -t pasta-api .
#
# Turborepo's pruner keeps each stage's context to just this app and the
# packages it actually depends on, so a change to the admin panel does not
# invalidate the API's dependency layer.

FROM node:22-alpine AS base
RUN corepack enable
# The repo's `prepare` script installs git hooks, which have no meaning inside
# an image and fail when devDependencies are skipped.
ENV HUSKY=0
WORKDIR /app

# --- prune: isolate @pasta/api and its workspace dependencies ----------------
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2 prune @pasta/api --docker

# --- deps: install against the pruned lockfile ------------------------------
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# --- build: compile the API and generate the Prisma client ------------------
FROM base AS builder
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=@pasta/api

# --- deps-prod: production-only dependencies --------------------------------
FROM base AS deps-prod
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile --prod

# --- runtime ----------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

# Never run as root.
RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001

ENV NODE_ENV=production

COPY --from=deps-prod --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=deps-prod --chown=nestjs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps-prod --chown=nestjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nestjs:nodejs /app/packages/types/dist ./packages/types/dist
COPY --from=builder --chown=nestjs:nodejs /app/packages/utils/dist ./packages/utils/dist
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/package.json ./apps/api/package.json
# Migrations and the schema ship with the image so `migrate deploy` can run
# from the same artefact that serves traffic.
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
# The seed imports the generated client from source, so `dist` alone is not
# enough for `db seed` to run inside this image.
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/src/generated ./apps/api/src/generated

USER nestjs
WORKDIR /app/apps/api
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/'+(process.env.API_PREFIX||'api/v1')+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
