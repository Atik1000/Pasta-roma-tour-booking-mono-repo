# Production environment for Pasta Roma Tour.
#
#   cp .env.production.example .env.production
#   ./scripts/generate-secrets.sh        # fills the three secrets below
#
# Never commit the filled-in file. It is already in .gitignore.

# --- database ------------------------------------------------------------------
POSTGRES_USER=pasta
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pasta_roma_tour

# --- secrets -------------------------------------------------------------------
# 32+ characters each and different from one another. `generate-secrets.sh`
# writes real values here; an instance that boots with a known secret is one
# anyone can mint admin tokens for.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- public addresses ----------------------------------------------------------
# Use https:// once TLS is terminated. Refresh cookies are `secure` in
# production and will not survive plain HTTP, so login breaks without it.
SITE_URL=https://your-domain.com
ADMIN_URL=https://admin.your-domain.com
PUBLIC_API_URL=https://api.your-domain.com/api/v1

# Browser origins allowed to call the API. Anything not listed is refused.
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# --- ports on the host ---------------------------------------------------------
# Bound behind a reverse proxy; Postgres and Redis are never published.
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

# --- Stripe --------------------------------------------------------------------
# Leave empty to launch without card payment: the payment routes answer 503 and
# everything else runs. See docs/PAYMENTS.md.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- mail ----------------------------------------------------------------------
# Without SMTP the API logs mail instead of sending it, so booking
# confirmations and the booking-lookup links will not arrive.
SMTP_URL=
MAIL_FROM=Pasta Roma Tour <no-reply@your-domain.com>

# --- misc ----------------------------------------------------------------------
SWAGGER_ENABLED=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Payments ---------------------------------------------------------------
# Which gateway opens NEW card payments: revolut | stripe.
# Existing payments always stay with the gateway that took them, so switching
# this does not make yesterday's takings unrefundable.
PAYMENT_PROVIDER=revolut

# Revolut Merchant API — https://developer.revolut.com/docs/merchant/merchant-api
# Sandbox: https://sandbox-merchant.revolut.com   Live: https://merchant.revolut.com
REVOLUT_API_URL=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=
REVOLUT_PUBLIC_KEY=
# From the webhook you create for POST {API}/payments/webhook/revolut.
# Comma-separate two values while rotating the secret.
REVOLUT_WEBHOOK_SECRET=
